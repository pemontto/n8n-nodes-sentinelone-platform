{
	"name": "Platform test 2 - Update and verification",
	"nodes": [
		{
			"parameters": {},
			"id": "00000000-0000-4000-8000-000000000005",
			"name": "Start test",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [0, 0]
		},
		{
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "return { json: { alertId: '', expectedAccountName: 'XDR Demo', updates: { status: 'IN_PROGRESS', ticketId: { externalTicketId: 'demo-ticket', test: 'platform acceptance' } } } };"
			},
			"id": "00000000-0000-4000-8000-000000000006",
			"name": "Configure test",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [220, 0]
		},
		{
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "const config = $json;\nif (typeof config.alertId !== 'string' || !config.alertId.trim()) throw new Error('Set an explicit disposable XDR Demo alert ID in Configure test.');\nif (config.expectedAccountName !== 'XDR Demo') throw new Error('The expected account must remain XDR Demo.');\nreturn { json: { ...config, alertId: config.alertId.trim() } };"
			},
			"id": "00000000-0000-4000-8000-000000000007",
			"name": "Require explicit alert ID",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [440, 0]
		},
		{
			"parameters": {
				"resource": "alert",
				"operation": "get",
				"alertId": "={{ $json.alertId }}",
				"options": {}
			},
			"id": "00000000-0000-4000-8000-000000000008",
			"name": "Get designated alert",
			"type": "n8n-nodes-sentinelone-platform.sentinelOnePlatform",
			"typeVersion": 1,
			"position": [660, 0]
		},
		{
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "const config = $('Require explicit alert ID').item.json;\nconst alert = $json;\nif (alert.id !== config.alertId) throw new Error('Fetched alert ID does not match the explicit test ID.');\nif (alert.realTime?.scope?.account?.name !== 'XDR Demo') throw new Error('Write blocked: the fetched alert is not in XDR Demo or account metadata is missing.');\nreturn { json: { alertId: alert.id, original: { status: alert.status, analystVerdict: alert.analystVerdict, ticketId: alert.ticketId }, updates: config.updates } };"
			},
			"id": "00000000-0000-4000-8000-000000000009",
			"name": "Guard demo account",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [880, 0]
		},
		{
			"parameters": {
				"resource": "alert",
				"operation": "update",
				"alertId": "={{ $json.alertId }}",
				"updateFields": {},
				"useAdvancedUpdatePayload": true,
				"advancedUpdatePayload": "={{ $json.updates }}",
				"options": {
					"verifyUpdate": true
				}
			},
			"id": "00000000-0000-4000-8000-000000000010",
			"name": "Update designated alert",
			"type": "n8n-nodes-sentinelone-platform.sentinelOnePlatform",
			"typeVersion": 1,
			"position": [1100, 0]
		},
		{
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "const before = $('Guard demo account').item.json;\nreturn { json: { original: before.original, requested: before.updates, result: $json } };"
			},
			"id": "00000000-0000-4000-8000-000000000011",
			"name": "Review update result",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [1320, 0]
		}
	],
